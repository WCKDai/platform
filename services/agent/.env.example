# Copy to .env and replace every value.  Never commit the result.
PANEL_DOMAIN=agent.example.com

# The panel's one operator password, as a hash (node panel/scripts/hash-password.mjs '...').
PANEL_PASSWORD_HASH=scrypt:replace:replace
PANEL_SECRET=replace-with-at-least-32-random-characters
PANEL_SECURE_COOKIES=true

# The token the local Invincible gateway issued (`invincible token`).
INVINCIBLE_TOKEN=replace-me

# Where the agent reaches Invincible.  In this compose file the gateway is not started;
# point this at the machine that runs it, or add the optional gateway profile.
GATEWAY_URL=http://host.docker.internal:7777/v1

# Interactive coding default; scheduled and board work still downgrade to allowlist.
APPROVALS_MODE=auto

# Optional image names.  The agent image is built from ./images/autobot after
# scripts/fetch-linux-binaries.sh; the panel is built from ./panel.
AUTOBOT_IMAGE=wckd/autobot:local
PANEL_IMAGE=wckd/agent-panel:local

# Host paths.
INVINCIBLE_DATA=./data/invincible
WORKSPACE=./workspace
